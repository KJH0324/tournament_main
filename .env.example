# 봇. 개발자 포털의 토큰, 공개 키, 애플리케이션 아이디.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# 이 봇을 쓰는 서버 아이디. 쉼표로 여러 개. 비우면 예전 기본 서버만 본다.
DISCORD_GUILD_IDS=

# 챌롱. 없으면 대진표 연동은 쉬고, 나머지 명령은 동작한다.
CHALLONGE_API_KEY=

# 비우면 미리보기는 메모리 DB를 쓴다. 배포는 Neon 연결 문자열.
DATABASE_URL=

# 메인 관리자. 아이디와 인증 앱에 넣은 Base32 키.
# otpauth://totp/레이븐:아이디?secret=키&issuer=레이븐&algorithm=SHA1&digits=6&period=30
ADMIN_ID=
ADMIN_TOTP_SECRET=

# 비우면 위 두 값으로 세션 키를 만든다. 넣으면 32자 이상.
ADMIN_SESSION_SECRET=

# 비상 메일. 발신은 Resend에 인증된 주소.
RESEND_API_KEY=
RESEND_FROM=레이븐 토너먼트 <alerts@raven-tournament.xyz>
